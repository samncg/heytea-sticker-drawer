{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sticker Drawer",
  "version": "1.0.0",
  "identifier": "dev.ncgg.stickerdrawer",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sticker Drawer",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 660,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
